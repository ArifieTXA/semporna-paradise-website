---
/**
 * SiteHeader — rebuilt to the BelArosa pattern, 2026-09-04.
 *
 * Measured off the reference at 1920px (~/website-clones/belarosa-chalet/):
 *
 *   MENU (hamburger + tracked label) ...... left, over the hero, no background
 *   the logo ...... a solid dark tile hanging from the top edge, dead centre
 *   language + one outlined button ........ right
 *
 * There is no nav bar. Every link lives in <MenuOverlay>, which the MENU button
 * opens. That is the reference's whole navigation model and it is why its hero
 * can be edge-to-edge with nothing floating over it.
 *
 * ── The header follows the live scroll theme ─────────────────────────────
 * The bar itself is TRANSPARENT and its text is `var(--t-text)`. Because
 * src/lib/scroll-theme.ts rewrites `--t-text` on <html> as sections cross
 * mid-viewport, the header text turns white over a dark band and dark over a
 * light one, with no per-section class and no scroll handler of its own. This
 * is the single most recognisable thing about the reference.
 *
 * The centred logo tile is the exception: it is a fixed Ocean Deep block, so
 * its contents stay white on every theme, exactly as the reference's does.
 *
 * Rules kept from the previous header: every target is >= 44x44 (v1 shipped
 * 18px targets, defect #12), and every href comes from the typed route map, so
 * a dead link is a compile error rather than a 404 (defect #4).
 * Hard rule 4 — the licence is a LABEL. Nothing here claims validity.
 */
import { href, ROUTES, type RouteId, type Lang } from "../lib/routes";
import { COMPANY, PRIMARY_WA } from "../data/config";
import { waLink } from "../lib/whatsapp";
import MenuOverlay from "./MenuOverlay.astro";

interface Props {
  lang: Lang;
  route?: RouteId;
  path?: string;
  twinPath?: string;
}

const { lang, route, path, twinPath } = Astro.props;

const t = {
  bm: { menu: "Menu", wa: "WhatsApp", other: "EN", otherFull: "Tukar ke English", skipTo: "Menu utama" },
  en: { menu: "Menu", wa: "WhatsApp", other: "BM", otherFull: "Switch to Bahasa Malaysia", skipTo: "Main menu" },
}[lang];

// The language toggle points at THIS page's twin, never at the site root.
const otherLang: Lang = lang === "bm" ? "en" : "bm";
const twinHref = route ? ROUTES[route][otherLang] : (twinPath ?? (otherLang === "en" ? "/en/" : "/"));

const homeHref = href("home", lang);
const waUrl = waLink(
  { product: lang === "bm" ? "Pertanyaan umum" : "General enquiry" },
  lang,
  PRIMARY_WA,
);
---

<header class="hdr" data-nav>
  <div class="hdr__row">
    <button
      class="hdr__menu"
      id="menu-open"
      type="button"
      aria-expanded="false"
      aria-controls="menu-overlay"
    >
      <svg class="hdr__burger" viewBox="0 0 24 24" width="20" height="14" aria-hidden="true" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width="1.4" d="M2 5h20M2 12h20M2 19h20" />
      </svg>
      <span class="hdr__menu-text">{t.menu}</span>
    </button>

    <a class="hdr__logo" href={homeHref} aria-label={`${COMPANY.shortName} — ${COMPANY.legalName}`}>
      <img
        src="/brand/fish-mark.png"
        srcset="/brand/fish-mark.png 1x, /brand/fish-mark@2x.png 2x"
        width="44"
        height="44"
        alt=""
        decoding="async"
      />
      <span class="hdr__wordmark">Semporna<br />Paradise</span>
      <span class="hdr__sub">{COMPANY.licenceLabel}</span>
    </a>

    <div class="hdr__end">
      <a class="hdr__lang" href={twinHref} hreflang={otherLang === "bm" ? "ms-MY" : "en-MY"} title={t.otherFull}>
        <span aria-hidden="true">{t.other}</span>
        <span class="u-sr">{t.otherFull}</span>
      </a>
      <a class="hdr__wa" href={waUrl} rel="noopener">{t.wa}</a>
    </div>
  </div>
</header>

<MenuOverlay lang={lang} route={route} />

<style>
  /* The bar floats over the page with no background of its own, exactly like
     the reference — that is what lets the hero run edge to edge.

     ── Deliberate deviation, found in QA at 1440px, 2026-09-04 ────────────
     Past the hero it takes a solid background. The reference can stay
     transparent the whole way down because every one of its sections is an
     image or a short editorial block. Ours are not: the packages band is a
     20-row price table, and with a transparent bar its rows scrolled up
     *through* the header — a row's "TANYA DI WHATSAPP" button rendering on
     top of the header's own WhatsApp button, and the sticky table head
     showing rows through it.

     So the bar is transparent at rest, which is the whole hero, and opaque
     from 40px of scroll onward, which is where the collisions were. The
     background follows the live scroll theme, so it still reads as one
     surface with the section under it rather than as a separate chrome bar. */
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    color: var(--t-text);
    background: transparent;
    transition:
      color 700ms var(--ease-water),
      background-color 700ms var(--ease-water);
  }
  .hdr[data-scrolled] { background: var(--t-bg); }

  /* A hairline under the opaque bar — a border appearing, never a shadow.
     The reference is shadowless throughout and this stays true to that. */
  .hdr[data-scrolled]::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--t-rule);
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr { transition: none; }
  }

  .hdr__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 1rem;
    padding: 0 clamp(1rem, 2.5vw, 2.5rem);
  }

  /* ---- MENU, left ---- */
  .hdr__menu {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 44px;
    margin-top: 0.75rem;
    padding: 0.5rem 0.5rem 0.5rem 0.25rem;
    background: none;
    border: 0;
    border-radius: 0;
    color: inherit;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .hdr__menu:hover .hdr__burger { transform: scaleX(0.82); }
  .hdr__burger { transition: transform var(--dur-micro) var(--ease-micro); transform-origin: left; }

  /* ---- The logo tile, centred, hanging from the top edge ---- */
  .hdr__logo {
    justify-self: center;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: 1rem clamp(1.25rem, 2.5vw, 2rem) 1.1rem;
    background: #0A1628;   /* fixed, not themed — as on the reference */
    color: #fff;
    text-decoration: none;
    border-radius: 0;
    min-width: 8.5rem;
  }

  .hdr__wordmark {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.08;
    text-align: center;
    letter-spacing: 0.01em;
  }

  .hdr__sub {
    font-size: 0.5625rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #E0C08A;
    font-variant-numeric: tabular-nums;
  }

  /* ---- Language + WhatsApp, right ---- */
  .hdr__end {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .hdr__lang,
  .hdr__wa {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 0.875rem;
    color: inherit;
    text-decoration: none;
    border-radius: 0;
    font-size: var(--text-caption);
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hdr__wa {
    border: 1px solid currentColor;
    padding-inline: 1.125rem;
    transition:
      background-color var(--dur-micro) var(--ease-micro),
      color var(--dur-micro) var(--ease-micro);
  }
  /* Hover inverts against whatever theme is live: the fill takes the current
     text colour and the label takes the current background. One pair per
     theme, so contrast is never accidental. */
  .hdr__wa:hover { background: #0A1628; color: #FFFFFF; }
  :global(:root[data-theme="2"]) .hdr__wa:hover { background: #FFFFFF; color: #0A1628; }
  :global(:root[data-theme="3"]) .hdr__wa:hover { background: #0A1628; color: #F1EBE0; }

  .hdr__lang:hover { color: var(--t-accent); }

  .u-sr {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%);
    white-space: nowrap; border: 0;
  }

  @media (max-width: 719px) {
    .hdr__menu-text { display: none; }
    .hdr__lang { padding-inline: 0.5rem; }
    .hdr__wa { padding-inline: 0.875rem; }
    .hdr__logo { min-width: 0; padding-inline: 0.875rem; }
    .hdr__wordmark { font-size: 0.9375rem; }
  }
</style>
