---
/**
 * Fixed shell, BelArosa pattern: a white full-width bar with no shadow —
 * hamburger + "MENU" left, the centred logo lockup (gold diamond mark,
 * serif wordmark, tracked "TRAVEL & TOURS" beneath), language + outlined
 * "TEMPOH" pill right — and beneath it, on desktop, the sub-category row
 * of uppercase tracked slate links with a honey-gold underline for the
 * active state. A hairline appears after 40px of scroll — a border
 * appearing, not a shadow (the reference is shadowless throughout).
 *
 * Every target is >= 44x44px. v1 shipped 18px nav targets (defect #12).
 * Every href comes from the typed route map, so a dead link is a compile error.
 *
 * The lockup carries the Semporna Paradise fish mark (a modern flat-vector
 * redraw of the owner's logo, generated 2026-09-02) to the left of the
 * wordmark. It replaces the provisional gold diamond.
 */
import { navRoutes, href, navTitle, ROUTES, type RouteId, type Lang } from "../lib/routes";
import { COMPANY } from "../data/config";
import { waLink } from "../lib/whatsapp";
import { PRIMARY_WA } from "../data/config";

interface Props {
  lang: Lang;
  route?: RouteId;
  path?: string;
  twinPath?: string;
}

const { lang, route, path, twinPath } = Astro.props;

const items = navRoutes();
const current = route ? ROUTES[route][lang] : path;

/**
 * Current-section match by PREFIX, not equality — so deep pages
 * (/resort/[slug]/, /selam-padi/sipadan/, /pakej/resort/, the /en/ twins…)
 * still light their parent nav item. The site root is exact-only, because
 * every path starts with "/" and every EN path with "/en/". The Trust &
 * Safety page has no nav item of its own — it sits under the About item.
 */
const homePath = ROUTES.home[lang];
const trustPath = ROUTES.trust[lang];
function isCurrent(id: RouteId): "page" | undefined {
  const target = ROUTES[id][lang];
  if (target === homePath) return current === homePath ? "page" : undefined;
  if (!current) return undefined;
  let hit = current === target || current.startsWith(target);
  if (id === "about" && !hit) hit = current === trustPath || current.startsWith(trustPath);
  return hit ? "page" : undefined;
}

// The language toggle points at THIS page's twin, never at the site root.
const otherLang: Lang = lang === "bm" ? "en" : "bm";
const twinHref = route ? ROUTES[route][otherLang] : (twinPath ?? (otherLang === "en" ? "/en/" : "/"));

const homeHref = href("home", lang);
const menuLabel = lang === "bm" ? "Menu" : "Menu";
const closeLabel = lang === "bm" ? "Tutup menu" : "Close menu";
const navLabel = lang === "bm" ? "Navigasi utama" : "Main navigation";
const bookLabel = lang === "bm" ? "Tempahan" : "Book";
// Contact + FAQ were removed from the header on the owner's instruction
// (2026-09-02). Both still live in the footer's Information column.
const lockupSub = "Travel & Tours";
const waUrl = waLink({ product: lang === "bm" ? "Tempahan am" : "General booking" }, lang, PRIMARY_WA);
---

<header class="hdr" data-nav>
  <div class="hdr__bar">
    <div class="hdr__inner wrap">
      <div class="hdr__side hdr__side--start">
        <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-nav">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="none" stroke="currentColor" stroke-width="1.5" d="M3 7h18M3 12h18M3 17h18" />
          </svg>
          <span class="burger__label">{menuLabel}</span>
        </button>
      </div>

      <a class="brand" href={homeHref} aria-label={`${COMPANY.shortName} — ${COMPANY.legalName}`}>
        <img
          class="brand__mark"
          src="/brand/fish-mark.png"
          srcset="/brand/fish-mark.png 1x, /brand/fish-mark@2x.png 2x"
          alt=""
          width="44"
          height="44"
          decoding="async"
          fetchpriority="high"
        />
        <span class="brand__lockup">
          <span class="brand__name">Semporna Paradise</span>
          <span class="brand__sub">{lockupSub}</span>
        </span>
      </a>

      <div class="hdr__side hdr__side--end">
        <a class="lang" href={twinHref} hreflang={otherLang === "bm" ? "ms-MY" : "en-MY"}>
          {otherLang === "bm" ? "BM" : "EN"}
        </a>
        <a class="book" href={waUrl} target="_blank" rel="noopener noreferrer">{bookLabel}</a>
      </div>
    </div>

    <nav class="subnav wrap" aria-label={navLabel}>
      <ul class="subnav__list">
        {items.map((id) => (
          <li>
            <a
              href={href(id, lang)}
              aria-current={isCurrent(id)}
            >
              {navTitle(id, lang)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div
    class="sheet"
    id="mobile-nav"
    hidden
    data-surface="dark"
    role="dialog"
    aria-modal="true"
    aria-label={navLabel}
  >
    <div class="sheet__inner wrap">
      <button class="sheet__close" type="button">
        <span class="u-sr">{closeLabel}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="none" stroke="currentColor" stroke-width="1.5" d="m5 5 14 14M19 5 5 19" />
        </svg>
      </button>
      <p class="sheet__eyebrow">{COMPANY.licenceLabel} &middot; Semporna, Sabah</p>
      <ul class="sheet__list">
        {items.map((id) => (
          <li>
            <a href={href(id, lang)}
               aria-current={isCurrent(id)}>
              {navTitle(id, lang)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".hdr");
  const burger = header?.querySelector<HTMLButtonElement>(".burger");
  const sheet = header?.querySelector<HTMLElement>(".sheet");
  const closeBtn = header?.querySelector<HTMLButtonElement>(".sheet__close");

  if (burger && sheet && closeBtn) {
    const focusables = () =>
      Array.from(sheet.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"));

    function open() {
      sheet!.hidden = false;
      burger!.setAttribute("aria-expanded", "true");
      document.documentElement.style.overflow = "hidden";
      focusables()[0]?.focus();
    }

    function close() {
      sheet!.hidden = true;
      burger!.setAttribute("aria-expanded", "false");
      document.documentElement.style.overflow = "";
      burger!.focus();
    }

    burger.addEventListener("click", open);
    closeBtn.addEventListener("click", close);

    document.addEventListener("keydown", (e) => {
      if (sheet.hidden) return;

      if (e.key === "Escape") { close(); return; }

      // Focus trap.
      if (e.key === "Tab") {
        const list = focusables();
        if (!list.length) return;
        const first = list[0];
        const last = list[list.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault(); first.focus();
        }
      }
    });
  }
</script>

<style>
  .u-sr {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-snow);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-micro) var(--ease-micro);
  }
  .hdr[data-scrolled] { border-bottom-color: var(--color-rule-light); }

  .hdr__bar { padding-block: 0.75rem; }
  .hdr[data-scrolled] .hdr__bar { padding-block: 0.5rem; }
  .hdr__bar { transition: padding var(--dur-micro) var(--ease-micro); }

  .hdr__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .hdr__side { display: flex; align-items: center; gap: 0.625rem; }
  .hdr__side--end { justify-content: flex-end; }

  /* ---- Centre lockup ---- */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    text-decoration: none;
    color: var(--color-ink);
    padding-block: 0.375rem;
  }
  .brand {
    min-width: 0;
    gap: clamp(0.5rem, 2vw, 0.875rem);
  }
  @media (max-width: 559px) {
    .brand__name { font-size: 1.0625rem; }
    .brand__sub  { letter-spacing: 0.3em; font-size: 0.5rem; }
    .book { padding-inline: 1rem; }
    .burger { padding-inline: 0 0.25rem; }
    .burger__label { display: none; }
  }
  .brand__name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .brand__sub {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.5625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.42em;
    text-align: center;
    color: var(--color-ink-muted);
  }
  /* The Semporna Paradise fish mark. Decorative here — the <a> already
     carries the accessible name — so alt="" and no separate label. */
  .brand__mark {
    flex: none;
    width: clamp(26px, 5.6vw, 44px);
    height: auto;
    transition: transform var(--dur-enter) var(--ease-water);
  }
  .brand:hover .brand__mark { transform: translateX(3px) rotate(-4deg); }
  @media (prefers-reduced-motion: reduce) {
    .brand__mark, .brand:hover .brand__mark { transition: none; transform: none; }
  }

  /* ---- Left: burger + MENU ---- */
  .burger {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    padding-inline: 0.25rem 0.75rem;
    background: transparent;
    border: 0;
    color: var(--color-ink);
    cursor: pointer;
  }
  .burger svg { width: 22px; height: 22px; }
  .burger__label {
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }
  @media (min-width: 1024px) { .burger { visibility: hidden; pointer-events: none; } }
  /* When the links row is collapsed on scroll, the Menu button returns at every width. */
  .hdr[data-collapsed] .burger { visibility: visible; pointer-events: auto; }

  /* ---- Right: lang + BOOK pill ---- */
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-ink);
    text-decoration: none;
  }
  .lang:hover { color: var(--color-deep-lift); text-decoration: underline; text-underline-offset: 5px; }

  .book {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.625rem 1.625rem;
    border: 1.5px solid var(--color-border-light);
    border-radius: var(--radius-pill);
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      background-color var(--dur-micro) var(--ease-micro),
      color var(--dur-micro) var(--ease-micro);
  }
  .book:hover { background: var(--color-deep); color: var(--color-paper); }

  /* ---- Sub-nav: tracked uppercase, gold underline for active ---- */
  .subnav { display: none; }
  @media (min-width: 1024px) {
    .subnav {
      display: block;
      border-top: 1px solid var(--color-rule-light);
      margin-top: 0.5rem;
      padding-block: 0.125rem;
      overflow: hidden;
      max-height: 8rem;
      opacity: 1;
      transition:
        max-height var(--dur-micro) var(--ease-micro),
        opacity var(--dur-micro) var(--ease-micro),
        margin-top var(--dur-micro) var(--ease-micro),
        padding-block var(--dur-micro) var(--ease-micro),
        border-top-color var(--dur-micro) var(--ease-micro),
        visibility var(--dur-micro) var(--ease-micro);
    }
    /* Past 120px scroll the links row slides away; the compact bar stays.
       `visibility: hidden` takes the 6 links out of the tab order too — without
       it, tabbing past the collapse point parks focus on a clipped link. */
    .hdr[data-collapsed] .subnav {
      max-height: 0;
      opacity: 0;
      margin-top: 0;
      padding-block: 0;
      border-top-color: transparent;
      pointer-events: none;
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .subnav { transition: none; }
  }

  .subnav__list {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .subnav__list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;              /* WCAG 2.2 target size */
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color var(--dur-micro) var(--ease-micro);
  }
  .subnav__list a:hover { color: var(--color-deep-lift); }
  .subnav__list a[aria-current="page"] {
    font-weight: 600;
    border-bottom-color: var(--color-gold);
  }

  /* ---- Mobile sheet ---- */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-deep);
    color: var(--color-paper);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .sheet__inner { padding-block: 1.5rem 4rem; }

  .sheet__eyebrow {
    font-size: var(--text-caption);
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--color-paper-muted);
    margin-top: 1.5rem;
  }

  .sheet__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin-left: auto;
    border: 1px solid var(--color-rule-dark);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-paper);
    cursor: pointer;
  }
  .sheet__close svg { width: 20px; height: 20px; }

  .sheet__list { list-style: none; margin: 1rem 0 0; padding: 0; }
  .sheet__list li + li { border-top: 1px solid var(--color-rule-dark); }
  .sheet__list a {
    display: flex;
    align-items: center;
    min-height: 56px;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 500;
    color: var(--color-paper);
    text-decoration: none;
  }
  .sheet__list a[aria-current="page"] { color: var(--color-gold-soft); }

</style>
