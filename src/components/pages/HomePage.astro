---
/**
 * P001 — Laman Utama / Home. One component, both languages (parity, defect #11).
 *
 * REDESIGN-BRIEF §6.1: lead with the PRODUCT, not a quiz. §6.6: the <h1> names
 * the place in the page language; the registered English tagline stays a
 * supporting line, never the heading.
 *
 * ── De-slop pass 2026-09-02 ──────────────────────────────────────────────
 * The hero used to stack six decorative loops at once: rising bubbles, swaying
 * sun rays, a spinning badge, a drifting waterline, a word-by-word title
 * entrance and a bobbing scroll arrow. Together they read as a generated
 * landing page, so all six were removed at the owner's request.
 *
 * What is left is the hero doing its job: a generated underwater plate, a
 * headline that names the product and the place, one lead paragraph, and one
 * WhatsApp button. The plate is the only motion on the page above the fold.
 *
 * The hero plate is a GENERATED video (KIE / veo3_fast, 2026-09-02),
 * motion-interpolated 24 → 60 fps locally. It contains no real named property
 * and no people, so it clears CONTEXT.md hard rule 3 — and it is still
 * captioned as generated, per DESIGN.md §7, because at full bleed it would
 * otherwise read as documentary footage.
 *
 * Accessibility contract for the hero:
 *  - The video is decorative: aria-hidden, tabindex -1, muted, no audio track.
 *  - Sources are attached by JS, never in markup, so `prefers-reduced-motion`
 *    and Save-Data users never download or start it — the poster is the page.
 *  - WCAG 2.2.2: a real pause/play control sits in the hero, keyboard reachable.
 *
 * BelArosa editorial-luxury language is unchanged below the fold: flat
 * shadowless surfaces, depth from colour and 1px hairlines, a hairline
 * menu-style price list instead of a card grid, 50/50 splits with
 * edge-bleeding generated imagery, outlined pills, honey gold decorative only.
 */
import Base from "../../layouts/Base.astro";
import Gated from "../Gated.astro";
import WhatsAppCTA from "../WhatsAppCTA.astro";
import Img from "../Img.astro";
import GuestGallery from "../GuestGallery.astro";
import { gallery } from "../../data/photos";
import { RESORTS, fromPrice } from "../../data/resorts";
import { DAY_TRIPS } from "../../data/products";
import { href, resortDetailPath } from "../../lib/routes";
import { COMPANY } from "../../data/config";
import type { Lang } from "../../lib/gated";

interface Props { lang: Lang }
const { lang } = Astro.props;

const featured = [...RESORTS]
  .filter((r) => fromPrice(r) !== null)
  .sort((a, b) => (fromPrice(a) ?? 0) - (fromPrice(b) ?? 0))
  .slice(0, 6);

const c = {
  bm: {
