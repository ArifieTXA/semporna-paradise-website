  />

  {/* ---- 07 · Gallery of reels. Theme 3, sand. ----------------------- */}
  <section class="band" data-theme-section="3">
    <div class="rail">
      <p class="eyebrow-b">{c.galEyebrow}</p>
      <Reveal as="h2" text={c.galTitle} class="title-b" />
      <p class="lead-b">{c.galLead}</p>
    </div>
    <div class="gal__strip">
      <DragGallery lang={lang} id="reel-strip" label={c.galTitle}>
        {galleryTiles.map((t) => <VideoTile tile={t} lang={lang} />)}
      </DragGallery>
    </div>
  </section>

  {/* ---- 08 · Fullscreen teaser. Theme 2, dark. --------------------- */}
  <FullscreenTeaser
    lang={lang}
    eyebrow={c.teaserEyebrow}
    title={c.teaserTitle}
    lead={c.teaserLead}
    href={href("planner", lang)}
    cta={c.teaserCta}
  />

  {/* ---- 09 · Trip shaper. Theme 1, light. ---------------------------
         Teaser module 3 of 3 (centred). A wide 3:2 image, the text beneath it.
         No sticky travel here — there is no taller column beside it to travel
         inside, so the rule is dropped rather than left doing nothing. ----- */}
  <TeaserModule
    variant="centered"
    theme="1"
    eyebrow={c.planEyebrow}
    heading={c.planTitle}
    lead={c.planLead}
    href={href("planner", lang)}
    cta={c.planLink}
  >
    <div slot="media">
      <Img
        slot="cm-semporna-dusk"
        alt={creditAlt("cm-semporna-dusk", lang)}
        sizes="(min-width: 1200px) 88vw, 92vw"
      />
    </div>
    <ol class="steps steps--centered">
      {c.planSteps.map((s, i) => (
        <li class="steps__item">
          <span class="steps__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="steps__q">{s}</span>
        </li>
      ))}
    </ol>
  </TeaserModule>

  {/* ---- 10 · Master nav strip. Theme 3, sand. ----------------------- */}
  <section class="band band--tight" data-theme-section="3">
    <div class="rail">
      <p class="eyebrow-b">{c.navEyebrow}</p>
      <Reveal as="h2" text={c.navTitle} class="title-b" />
      <ul class="master">
        {MASTER.map((id, i) => (
          <li class="master__item">
            <a class="master__link" href={ROUTES[id][lang]}>
              <span class="master__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="master__t">{ROUTES[id].title[lang]}</span>
              <span class="master__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

