const resortCards = RESORTS.map((r) => ({
  resort: r,
  tile: TILES.find((t) => t.id === REEL_BY_SLUG[r.slug]) ?? null,
  plate: PLATE_BY_SLUG[r.slug] ?? null,
  from: fromPrice(r),
}));

/**
 * Reel tiles for the diving grid and the gallery strip.
 *
 * The diving grid is picked by SUBJECT, not by position: the first four
 * portrait tiles happened to be a resort dock and two near-identical boat
 * clips, which is not what a section headed "down to the wall" should show.
 * The gallery strip then takes everything the diving grid did not.
 */
const DIVE_SUBJECTS = ["seawalk", "snorkel", "hopping"];
const diveTiles = PORTRAIT_TILES
  .filter((t) => DIVE_SUBJECTS.includes(t.subject))
  .slice(0, 4);
const diveIds = new Set(diveTiles.map((t) => t.id));
const galleryTiles = PORTRAIT_TILES.filter((t) => !diveIds.has(t.id)).slice(0, 12);

/** The master-nav strip at the foot of the page, like the reference's. */
const MASTER: RouteId[] = [
  "packages", "resorts", "dayTrips", "diving", "sipadan",
  "planner", "trust", "about", "contact", "faq",
];

const c = {
  bm: {
