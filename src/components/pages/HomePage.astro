---
/**
 * P001 — Laman Utama / Home. One component, both languages (parity, defect #11).
 *
 * ── Rebuilt in the BelArosa Chalet language, 2026-09-04 ──────────────────
 * Reference capture: ~/website-clones/belarosa-chalet/ (screenshots at 1920 /
 * 1440 / 768 / 390, design tokens read out of the rendered DOM, not guessed).
 * Section order mirrors the reference: hero, vision, a teaser gallery of the
 * things you can book, an editorial run of topline + heading + bleeding image,
 * a drag gallery, the fullscreen teaser, the master-nav strip, footer.
 *
 * What carried over: three scroll themes swapping at mid-viewport, 0px radius
 * everywhere, 240px section rhythm, images bleeding past the container to the
 * viewport edge, transparent hairline-underline buttons, no shadows anywhere,
 * word-by-word heading reveals.
 *
 * What did NOT: the reference's muted grey (#8c9ba0, 3.19:1 on white — a
 * contrast failure is not a design decision), and its filled-button ban for
 * the one WhatsApp CTA, which is this site's only conversion action.
 *
 * ── Media ────────────────────────────────────────────────────────────────
 * The hero is the owner's own footage. The tiles are the company's own reels
 * from @sem4naparadise. The stills are either the seven cleared guest
 * photographs or free-licence Wikimedia Commons files, each attributed in the
 * footer. Owner override of 2026-09-03, CONTEXT.md §5. Provenance for every
 * file: img-raw/SOURCES.md.
 *
 * Other operators' marketing photography is NOT published anywhere on this
 * page. The owner cannot license what he does not own, so a resort card shows
 * the company's own reel of that resort, or a free-licence still, or nothing.
 *
 * ── Hard rules that still bind every line below ──────────────────────────
 * No hardcoded price (everything routes through <Gated>), no availability
 * claim, no safety guarantee, no licence-validity wording, no invented email,
 * no raw blocker token. CONTEXT.md §3.
 */
import Base from "../../layouts/Base.astro";
import Gated from "../Gated.astro";
import Img from "../Img.astro";
import WhatsAppCTA from "../WhatsAppCTA.astro";
import HeroVideo from "../HeroVideo.astro";
import VideoTile from "../VideoTile.astro";
import DragGallery from "../DragGallery.astro";
import FullscreenTeaser from "../FullscreenTeaser.astro";
import GuestGallery from "../GuestGallery.astro";
import PriceComparison from "../PriceComparison.astro";
import Reveal from "../Reveal.astro";
import TeaserModule from "../TeaserModule.astro";
import { gallery } from "../../data/photos";
import { RESORTS, fromPrice } from "../../data/resorts";
import { DAY_TRIPS } from "../../data/products";
import { TILES, PORTRAIT_TILES } from "../../data/tiles";
import { creditAlt } from "../../data/photo-credits";
import type { ImageSlot } from "../../lib/images";
import { href, resortDetailPath, ROUTES, type RouteId } from "../../lib/routes";
import type { Lang } from "../../lib/gated";

interface Props { lang: Lang }
const { lang } = Astro.props;

/* -------------------------------------------------------------------------- */
/* Resort cards.                                                              */
/*                                                                            */
/* Rebuilt 2026-09-04. What was here before: ten slugs mapped to a company     */
/* reel, and everything else cycling four generic Commons stills — so Danglai, */
/* Crystal, Seastar, Noura, Lato-Lato, Egang-Egang, Aminah, Borneo Divers and  */
/* Pakej Bandar all showed the same stilt-village and reef photographs. A card */
/* for a resort showed a stranger's house.                                    */
/*                                                                            */
/* Now every card is mapped by hand, one of two ways:                         */
/*                                                                            */
/*   REEL_BY_SLUG   the company's own footage of that resort, where the frame  */
/*                  actually shows the place. Checked one by one.              */
/*   PLATE_BY_SLUG  a generated plate matched to that resort's own look and    */
/*                  price tier, written from public research. No other         */
/*                  operator's photograph was used, as a source or as an image */
/*                  input — the owner cannot license what he does not own      */
/*                  (CONTEXT.md §5). The strip carries `resortsNote` under it, */
/*                  which says in the page that these are generated images of  */
/*                  the type of stay, not photographs of that resort.          */
/*                                                                            */
/* Four reels that name a resort in their caption were checked and rejected:   */
/* Danglai (night footage, heavy burnt-in overlay), Egang-Egang (a bathroom    */
/* sink), Borneo Divers (a tree trunk) and Noura (a piece to camera, an        */
/* identifiable face, and a buka puasa visit rather than a stay). Sisipan,     */
/* Nusakuya and Bihing Angan had built tiles, but the frames showed a bathtub, */
/* a toilet and a watermarked dusk shot, so they take plates too. Adil keeps   */
/* its zipline frame: the zipline is a real inclusion on that package          */
/* (resorts.ts INC.zipline).                                                  */
/* -------------------------------------------------------------------------- */

const REEL_BY_SLUG: Record<string, string> = {
  "adil-waterhouse":   "reel-Da38CbYzyF4",
  "royal":             "reel-DYnrsm5DMF8",
  "dayang":            "reel-DYvfflFlOUm",
  "singamata-basic":   "reel-DYvaKb",
  "maglami-lami":      "reel-DYnruNyDtRQ",
  "paghalian":         "reel-DYN6RsbEpQp",
};

/** Generated plates, one per resort. Keys never collide with REEL_BY_SLUG. */
const PLATE_BY_SLUG: Record<string, ImageSlot> = {
  "danglai":             "resort-danglai-type",
  "sisipan":             "resort-sisipan-type",
  "crystal":             "resort-crystal-type",
  "seastar":             "resort-seastar-type",
  "noura":               "resort-noura-type",
  "singamata-deluxe":    "resort-generic-1",
  "lato-lato":           "resort-latolato-type",
  "bihing-angan":        "resort-bihing-type",
  "egang-egang-fan":     "resort-egang-type",
  "egang-egang-ac":      "resort-chalet-ac",
  "aminah":              "resort-aminah-type",
  "nusakuya":            "resort-nusakuya-type",
  "borneo-divers-mabul": "resort-borneodivers-type",
  "pakej-bandar":        "resort-town-type",
};

/** Alt text for the plates. Describes the frame, never claims the building. */
