  {/* ---- 03 · Day trips ------------------------------------------------ */}
  <section class="section--tall band-bleed" data-surface="sand" data-reveal>
    <div class="band-bleed__grid">
      <div class="band-bleed__text">
        <p class="eyebrow">{c.b2eyebrow}</p>
        <h2 class="sec__title">{c.b2title}</h2>
        <p class="sec__lead">{c.b2lead}</p>
        <ul class="trips">
          {DAY_TRIPS.map((tr) => (
            <li class="trip">
              <div>
                <h3 class="trip__name">{tr.area[lang]}</h3>
                <p class="trip__dest">{tr.destinations.join(" · ")}</p>
              </div>
              <p class="trip__price">
                <Gated value={tr.local} kind="price" blocker="B02" lang={lang} />
                <span>{c.perPerson}</span>
              </p>
            </li>
          ))}
        </ul>
        <a class="pill" href={href("dayTrips", lang)}>{c.b2link}</a>
      </div>
      <div class="band-bleed__media band-bleed__media--right">
        <Img slot="harian-hero" alt={c.b2imgAlt} sizes="(min-width: 960px) 50vw, 100vw" />
      </div>
    </div>
  </section>

  {/* ---- 03b · Guest gallery ------------------------------------------
      The only real photographs on the site. Cleared 2026-09-02 (CONTEXT.md §5).
      Sits between the sand band above and the dark diving band below, so the
      two-tone oscillation still alternates. */}
  <GuestGallery
    lang={lang}
    surface="light"
    items={gallery(["boatGroup", "heartSandbar", "sandbarSea"], lang)}
  />

  {/* ---- 04 · Diving --------------------------------------------------- */}
  <section class="section--tall band-bleed band-bleed--dive" data-surface="dark" data-reveal>
    <div class="band-bleed__grid">
      <div class="band-bleed__text">
        <p class="eyebrow">{c.b3eyebrow}</p>
        <h2 class="sec__title">{c.b3title}</h2>
        <p class="sec__lead">{c.b3lead}</p>
        <div class="band-cta band-cta--start">
          <WhatsAppCTA lang={lang} code="SPTT-DV-SIPADAN" product="Sipadan" label={c.b3cta} />
          <a class="pill" href={href("diving", lang)}>{c.b3link}</a>
        </div>
      </div>
      <div class="band-bleed__media band-bleed__media--left">
        <Img slot="selam-hero" alt={c.b3imgAlt} sizes="(min-width: 960px) 50vw, 100vw" />
      </div>
    </div>
  </section>

  {/* ---- 05 · Planner -------------------------------------------------- */}
  <section class="section--tall band-light" data-surface="light" data-reveal>
    <div class="wrap">
      <div class="band-head">
        <p class="eyebrow eyebrow--center">{c.b4eyebrow}</p>
        <h2 class="sec__title sec__title--center">{c.b4title}</h2>
        <p class="sec__lead sec__lead--center">{c.b4lead}</p>
      </div>
      <ol class="steps">
        {c.b4steps.map((s, i) => (
          <li class="steps__item">
            <span class="steps__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <p class="steps__q">{s}</p>
          </li>
        ))}
      </ol>
      <div class="band-cta band-cta--center">
        <a class="pill" href={href("planner", lang)}>{c.b4link}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  /**
   * The hero plate. Sources are attached HERE, never in markup, so a
   * reduced-motion or Save-Data visitor never downloads ~3 MB of video —
   * they get the poster, which is a still frame of the same plate.
   */
  const video = document.getElementById("hero-video") as HTMLVideoElement | null;
  const toggle = document.getElementById("hero-motion") as HTMLButtonElement | null;

  if (video && toggle) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const conn = (navigator as any).connection;
    const thrifty = Boolean(conn?.saveData) || /2g/.test(conn?.effectiveType ?? "");

    function attach() {
      if (video!.dataset.loaded) return;
      const mp4 = document.createElement("source");
      mp4.type = "video/mp4";
      mp4.src = video!.dataset.mp4!;
      video!.append(mp4);
      video!.dataset.loaded = "1";
      video!.load();
    }

    function setState(playing: boolean) {
      toggle!.setAttribute("aria-pressed", String(!playing));
      toggle!.setAttribute(
        "aria-label",
        playing ? toggle!.dataset.pause! : toggle!.dataset.play!,
      );
      toggle!.toggleAttribute("data-paused", !playing);
    }

    if (!reduce && !thrifty) {
      attach();
      video.play().then(() => {
        toggle.hidden = false;
        setState(true);
      }).catch(() => {
        /* Autoplay refused (some low-power modes). Offer it as a control. */
        toggle.hidden = false;
        setState(false);
      });
    } else {
      // Poster only. The button becomes an opt-in, not a pause.
      setState(false);
      toggle.hidden = false;
    }

    /* Distinguishes "the visitor pressed pause" from "the browser hid the tab".
       Only the first one survives the tab coming back into view. */
    let userPaused = reduce || thrifty;

    toggle.addEventListener("click", () => {
      if (video.paused) {
        attach();
        userPaused = false;
        void video.play();
        setState(true);
      } else {
        userPaused = true;
        video.pause();
        setState(false);
      }
    });

    // Do not burn a decode loop on a tab nobody is looking at — but do give the
    // plate back when the visitor returns, unless they paused it themselves.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        if (!video.paused) video.pause();
      } else if (!userPaused && video.paused) {
        void video.play().then(() => setState(true)).catch(() => setState(false));
      }
    });
  }
</script>

<style>
  /* ======================================================================
     HERO — a plate, a headline, a button
     ====================================================================== */
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--color-deep);
    color: var(--color-paper);
    /* Exactly the viewport MINUS the sticky header. A flat 94svh pushed the
       bottom edge below the fold by the header's own height. --hdr-h is the
       live header height (theme.css), so this stays correct as the bar
       shrinks on scroll. */
    min-height: clamp(30rem, calc(100svh - var(--hdr-h)), 56rem);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* ---- Plate ---- */
  .hero__media { position: absolute; inset: 0; z-index: -2; }
  .hero__video,
  .hero__media > .hero__scrim { position: absolute; inset: 0; }
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Pulled toward the brand slate so the plate never fights the palette. */
    filter: saturate(0.82) contrast(1.02);
  }
  /* Two scrims, not a decorative glow: they are what buy the text its contrast
     ratio over moving footage. The horizontal one anchors the left column
     (eyebrow, h1, lead, CTA); the vertical one seals the top strip under the
     header and the bottom into the band below. Measured against the brightest
     frame of the plate — the surface foam — not the average one. */
  .hero__scrim {
    background:
      linear-gradient(
        to right,
        color-mix(in oklab, var(--color-deep) 92%, transparent) 0%,
        color-mix(in oklab, var(--color-deep) 82%, transparent) 34%,
        color-mix(in oklab, var(--color-deep) 44%, transparent) 62%,
        color-mix(in oklab, var(--color-deep) 30%, transparent) 100%
      ),
      linear-gradient(
        to bottom,
