        </div>
      </div>
    </div>
  </section>

  {/* ---- 06 · Day trips. Theme 1, light. -----------------------------
         Teaser module 2 of 3 (image right). ------------------------------- */}
  <TeaserModule
    variant="right"
    theme="1"
    ratio="3 / 5"
    eyebrow={c.tripEyebrow}
    heading={c.tripTitle}
    lead={c.tripLead}
    href={href("dayTrips", lang)}
