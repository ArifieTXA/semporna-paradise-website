    bm: "Chalet kayu atas air berbumbung rumbia dengan laluan papan sempit, di atas air pirus cetek.",
    en: "Timber overwater chalets with thatched roofs and a narrow walkway, above shallow turquoise water.",
  },
  "resort-nusakuya-type": {
    bm: "Resort atas air kecil dilihat dari laut: bangunan utama berveranda dan beberapa chalet di atas tiang.",
    en: "A small overwater resort seen from the sea: a main building with a veranda and a few chalets on stilts.",
  },
  "resort-borneodivers-type": {
    bm: "Jeti kayu panjang menganjur dari pantai pasir putih berpokok kelapa, dengan bot selam di hujungnya.",
    en: "A long timber jetty out from a white sand beach lined with palms, a dive boat tied at the end.",
  },
  "resort-town-type": {
    bm: "Jeti bandar Semporna dengan deretan bot fiber kecil bertambat di kedua-dua belah.",
    en: "The Semporna town pier with rows of small fibreglass boats moored on both sides.",
  },
