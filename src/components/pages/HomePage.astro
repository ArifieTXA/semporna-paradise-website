  </section>

  {/* ---- 02 · Resort price list --------------------------------------- */}
  <section class="section--tall band-light" id="pakej" data-surface="light" data-reveal>
    <div class="wrap">
      <div class="band-head">
        <p class="eyebrow eyebrow--center">{c.b1eyebrow}</p>
        <h2 class="sec__title sec__title--center">{c.b1title}</h2>
        <p class="sec__lead sec__lead--center">{c.b1lead}</p>
      </div>

      <div class="pricelist">
        <div class="pricelist__head" aria-hidden="true">
          <span class="pricelist__head-name">{c.b1colName}</span>
          {DURS.map((d) => <span class="pricelist__head-col">{durLabels[d]}</span>)}
        </div>
        <ul class="pricelist__rows">
          {featured.map((r) => (
            <li>
              <a class="prow" href={resortDetailPath(r.slug, lang)}>
                <span class="prow__name">
                  <span class="prow__mark" aria-hidden="true"></span>
                  <span>
                    <span class="prow__title">{r.name}</span>
                    <span class="prow__room">{r.room}</span>
                  </span>
                </span>
                {DURS.map((d) => (
                  <span class="prow__cell">
                    <span class="prow__k">{durLabels[d]}</span>
                    <Gated value={r.prices[d]} kind="price" blocker={r.blockers?.[0]} lang={lang} />
