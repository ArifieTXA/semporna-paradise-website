const durLabels =
  lang === "bm"
    ? { "2D1N": "2H1M", "3D2N": "3H2M", "4D3N": "4H3M" }
    : { "2D1N": "2D1N", "3D2N": "3D2N", "4D3N": "4D3N" };
const DURS = ["2D1N", "3D2N", "4D3N"] as const;
---

<Base route="home" lang={lang} title={c.title} description={c.desc}>
  <section class="hero" data-surface="dark">
    {/* ---- The plate. Decorative: the page reads identically without it. ---- */}
    <div class="hero__media" aria-hidden="true">
      <video
        class="hero__video"
        id="hero-video"
        poster="/video/hero-poster.jpg"
        muted
        loop
        playsinline
        preload="none"
        tabindex="-1"
        data-mp4="/video/hero-60fps.mp4"></video>
      <div class="hero__scrim"></div>
    </div>

    <div class="wrap hero__inner">
      <div class="hero__stack">
        <p class="eyebrow hero__eyebrow">{c.heroEyebrow}</p>
        <h1 class="hero__title">{c.h1}</h1>
        <p class="hero__lead">{c.heroLead}</p>
        <div class="hero__actions">
          <WhatsAppCTA lang={lang} label={c.heroCta} product={lang === "bm" ? "Pertanyaan umum" : "General enquiry"} />
          <a class="hero__quiet" href={href("packages", lang)}>{c.heroQuiet}</a>
        </div>
        <p class="hero__tagline">{COMPANY.tagline}</p>
      </div>
    </div>

    {/* WCAG 2.2.2 — the looping plate must be stoppable. */}
    <button
      class="hero__motion"
      id="hero-motion"
      type="button"
      hidden
      data-play={c.playLabel}
      data-pause={c.pauseLabel}
      aria-label={c.pauseLabel}
    >
      <svg class="hero__motion-pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <rect x="4" y="3" width="2.5" height="10" fill="currentColor" />
        <rect x="9.5" y="3" width="2.5" height="10" fill="currentColor" />
      </svg>
      <svg class="hero__motion-play" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M5 3l8 5-8 5z" fill="currentColor" />
      </svg>
    </button>

    <p class="hero__credit">{c.heroCredit}</p>
  </section>

  {/* ---- 01 · Where you are ------------------------------------------- */}
  <section class="section--tall band-place" id="semporna" data-surface="sand" data-reveal>
    <div class="wrap">
      <div class="place__grid">
        <div class="place__text">
          <p class="eyebrow">{c.b0eyebrow}</p>
          <h2 class="sec__title">{c.b0title}</h2>
          <p class="sec__lead">{c.b0lead}</p>
          <ul class="place__list">
            {c.places.map((p) => (
              <li>
                <h3 class="place__name">{p.n}</h3>
                <p class="place__desc">{p.d}</p>
              </li>
            ))}
          </ul>
        </div>
        <figure class="place__figure">
          <Img slot="harian-island" alt={c.b0imgAlt} sizes="(min-width: 960px) 42vw, 100vw" ratio="4 / 5" />
          <figcaption>{c.genNote}</figcaption>
        </figure>
      </div>

      <div class="life">
        <h3 class="life__head">{c.lifeHead}</h3>
        <ul class="life__row">
          {c.life.map((it) => (
            <li class="life__item">
              <Img slot={it.slot as any} alt={it.alt} sizes="(min-width: 768px) 30vw, 90vw" ratio="1 / 1" />
              <span class="life__name">{it.n}</span>
