---
/**
 * P001 — Laman Utama / Home. One component, both languages (parity, defect #11).
 *
 * ── Rebuilt in the BelArosa Chalet language, 2026-09-04 ──────────────────
 * Reference capture: ~/website-clones/belarosa-chalet/ (screenshots at 1920 /
 * 1440 / 768 / 390, design tokens read out of the rendered DOM, not guessed).
 * Section order mirrors the reference: hero, vision, a teaser gallery of the
 * things you can book, an editorial run of topline + heading + bleeding image,
 * a drag gallery, the fullscreen teaser, the master-nav strip, footer.
 *
 * What carried over: three scroll themes swapping at mid-viewport, 0px radius
 * everywhere, 240px section rhythm, images bleeding past the container to the
 * viewport edge, transparent hairline-underline buttons, no shadows anywhere,
 * word-by-word heading reveals.
 *
 * What did NOT: the reference's muted grey (#8c9ba0, 3.19:1 on white — a
 * contrast failure is not a design decision), and its filled-button ban for
 * the one WhatsApp CTA, which is this site's only conversion action.
 *
 * ── Media ────────────────────────────────────────────────────────────────
 * The hero is the owner's own footage. The tiles are the company's own reels
 * from @sem4naparadise. The stills are either the seven cleared guest
 * photographs or free-licence Wikimedia Commons files, each attributed in the
 * footer. Owner override of 2026-09-03, CONTEXT.md §5. Provenance for every
 * file: img-raw/SOURCES.md.
 *
 * Other operators' marketing photography is NOT published anywhere on this
 * page. The owner cannot license what he does not own, so a resort card shows
 * the company's own reel of that resort, or a free-licence still, or nothing.
 *
 * ── Hard rules that still bind every line below ──────────────────────────
 * No hardcoded price (everything routes through <Gated>), no availability
 * claim, no safety guarantee, no licence-validity wording, no invented email,
 * no raw blocker token. CONTEXT.md §3.
 */
import Base from "../../layouts/Base.astro";
import Gated from "../Gated.astro";
import Img from "../Img.astro";
import WhatsAppCTA from "../WhatsAppCTA.astro";
import HeroVideo from "../HeroVideo.astro";
import VideoTile from "../VideoTile.astro";
import DragGallery from "../DragGallery.astro";
import FullscreenTeaser from "../FullscreenTeaser.astro";
import GuestGallery from "../GuestGallery.astro";
import PriceComparison from "../PriceComparison.astro";
import Reveal from "../Reveal.astro";
import { gallery } from "../../data/photos";
import { RESORTS, fromPrice } from "../../data/resorts";
import { DAY_TRIPS } from "../../data/products";
import { TILES, PORTRAIT_TILES } from "../../data/tiles";
import { creditAlt } from "../../data/photo-credits";
import { href, resortDetailPath, ROUTES, type RouteId } from "../../lib/routes";
import { COMPANY } from "../../data/config";
import type { Lang } from "../../lib/gated";

interface Props { lang: Lang }
const { lang } = Astro.props;

/* -------------------------------------------------------------------------- */
/* Resort cards. A resort shows the company's own reel of it where one exists  */
/* and a free-licence still otherwise. Never another operator's photography.   */
/* -------------------------------------------------------------------------- */

const REEL_BY_SLUG: Record<string, string> = {
  "adil-waterhouse":   "reel-Da38CbYzyF4",
  "royal":             "reel-DYnrsm5DMF8",
  "dayang":            "reel-DYvfflFlOUm",
  "sisipan":           "reel-DY8SKpQjZhK",
  "singamata-basic":   "reel-DYvaKb",
  "singamata-deluxe":  "reel-DYvaKb",
  "maglami-lami":      "reel-DYnruNyDtRQ",
  "paghalian":         "reel-DYN6RsbEpQp",
  "bihing-angan":      "reel-DY3Olyzisf7",
  "nusakuya":          "reel-DY5tWTZjUya",
};

/** Free-licence stand-ins, cycled so no two neighbours repeat. */
const FALLBACK_STILLS = ["cm-stilt-lagoon", "cm-stilt-village", "cm-reef-mosaic", "cm-white-beach"] as const;

const resortCards = RESORTS.map((r, i) => ({
  resort: r,
  tile: TILES.find((t) => t.id === REEL_BY_SLUG[r.slug]) ?? null,
  still: FALLBACK_STILLS[i % FALLBACK_STILLS.length],
  from: fromPrice(r),
}));

/**
 * Reel tiles for the diving grid and the gallery strip.
 *
 * The diving grid is picked by SUBJECT, not by position: the first four
 * portrait tiles happened to be a resort dock and two near-identical boat
 * clips, which is not what a section headed "down to the wall" should show.
 * The gallery strip then takes everything the diving grid did not.
 */
const DIVE_SUBJECTS = ["seawalk", "snorkel", "hopping"];
const diveTiles = PORTRAIT_TILES
  .filter((t) => DIVE_SUBJECTS.includes(t.subject))
  .slice(0, 4);
const diveIds = new Set(diveTiles.map((t) => t.id));
const galleryTiles = PORTRAIT_TILES.filter((t) => !diveIds.has(t.id)).slice(0, 12);

/** The master-nav strip at the foot of the page, like the reference's. */
const MASTER: RouteId[] = [
  "packages", "resorts", "dayTrips", "diving", "sipadan",
  "planner", "trust", "about", "contact", "faq",
];

const c = {
  bm: {
    title: "Pakej Pulau Semporna, Sabah",
    desc: "Pakej resort, lawatan harian pulau dan selam di Semporna, Sabah. Harga penuh disenaraikan. Hubungi kami di WhatsApp untuk pengesahan tempahan.",

    heroEyebrow: `Semporna · Sabah · ${COMPANY.licenceLabel}`,
    h1: "Kami bawa anda ke pulau",
    heroLead: "Resort atas air, lawatan harian dan selam di Laut Sulawesi.",
    scroll: "Tatal",
    playLabel: "Main semula video latar",
    pauseLabel: "Hentikan video latar",

    visionEyebrow: "Falsafah",
    visionTitle: "Perjalanan bermula di jeti yang sama, tetapi tiada dua perjalanan yang serupa.",
    visionLead:
      "Kami operator marin berlesen di Semporna, Sabah. Kami susun penginapan resort atas air, lawatan harian ke Tun Sakaran dan Mabul, serta kursus selam PADI — semuanya bertolak dari jeti bandar Semporna. Harga penuh ada di laman ini. Tiada tempahan dalam talian: setiap pertanyaan pergi terus kepada kami di WhatsApp.",
    visionCta: "Tentang kami",
    visionImgCap: "Perkampungan atas air di Taman Marin Tun Sakaran.",

    resortsEyebrow: "Resort",
    resortsTitle: "Resort",
    resortsSub: `${RESORTS.length} pilihan penginapan. Dari rumah atas air ke pakej bandar.`,
    resortsMore: "Bandingkan semua resort",
    from: "Dari",
    perPerson: "seorang",

    pkgEyebrow: "Pakej & harga",
    pkgTitle: "Bandingkan setiap resort, sebelah menyebelah.",
    pkgLead:
      "Harga setiap orang, mengikut tempoh menginap. Semua pakej termasuk penginapan, makan, dan pengangkutan lapangan terbang serta bot. Ketersediaan atas permintaan.",

    diveEyebrow: "Selam & Sipadan",
    diveTitle: "Turun ke tebing.",
    diveLead:
      "Selam skuba, pakej Sipadan, dan sijil PADI Open Water serta Advanced Open Water. Sipadan ialah kawasan dilindungi — permit ditetapkan oleh pihak berkuasa taman. Tempoh kursus adalah anggaran perancangan, bukan jaminan.",
    diveCta: "Tanya tentang Sipadan",
    diveLink: "Semua pakej selam",

    tripEyebrow: "Lawatan harian",
    tripTitle: "Empat laluan, satu hari, keluar dari jeti Semporna.",
    tripLead:
      "Bot, makan tengah hari, pemandu, bayaran jeti dan set snorkeling termasuk pada setiap laluan. Sewa jaket keselamatan berasingan.",
    tripLink: "Semua lawatan harian",
    tripPhotoEyebrow: "Foto perjalanan",
    tripPhotoTitle: "Rakaman sebenar dari perjalanan kami",
    tripPhotoLead:
      "Gambar ini dirakam semasa perjalanan kami di Semporna dan dikongsi dengan izin tetamu di dalamnya.",

    galEyebrow: "Galeri",
    galTitle: "Rakaman dari laut kami sendiri.",
    galLead: "Klip pendek dari perjalanan kami, tanpa bunyi. Seret untuk melihat.",

    teaserEyebrow: "Semporna",
    teaserTitle: "Laut ini tidak sama pada mana-mana dua hari.",
    teaserLead: "Beritahu kami bila anda mahu datang, dan kami susun perjalanannya.",
    teaserMarquee: "Terokai Semporna",
    teaserCta: "Rancang perjalanan",

    planEyebrow: "Rancang perjalanan",
    planTitle: "Pilih pakej dalam tiga soalan.",
    planLead:
      "Jawab tiga soalan — kami tunjukkan senarai pendek dan sediakan mesej WhatsApp yang sudah lengkap dengan kod pakej anda.",
    planSteps: [
      "Siapa yang pergi — keluarga, kumpulan, atau penyelam sertifikasi?",
      "Berapa malam — 2H1M, 3H2M, atau 4H3M?",
      "Snorkeling sahaja, atau mahu turun ke tebing Sipadan?",
    ],
    planLink: "Buka perancang perjalanan",

    navEyebrow: "Semua halaman",
    navTitle: "Ke mana seterusnya",
  },

  en: {
    title: "Semporna Island Packages, Sabah",
    desc: "Resort packages, island day trips and diving in Semporna, Sabah. Full prices listed. Contact us on WhatsApp to confirm a booking.",

    heroEyebrow: `Semporna · Sabah · ${COMPANY.licenceLabel}`,
    h1: "We bring you to the islands",
    heroLead: "Overwater resorts, island day trips and diving in the Celebes Sea.",
    scroll: "Scroll",
    playLabel: "Play the background video",
    pauseLabel: "Pause the background video",

    visionEyebrow: "Philosophy",
    visionTitle: "Every trip leaves from the same jetty, and no two of them are the same.",
    visionLead:
      "We are a licensed marine operator in Semporna, Sabah. We arrange overwater resort stays, day trips to Tun Sakaran and Mabul, and PADI dive courses — all of it leaving from the Semporna town jetty. Full prices are on this site. There is no online checkout: every enquiry goes straight to us on WhatsApp.",
    visionCta: "About us",
    visionImgCap: "A stilt village in the Tun Sakaran Marine Park.",

    resortsEyebrow: "Resorts",
    resortsTitle: "Resorts",
    resortsSub: `${RESORTS.length} places to stay. From overwater houses to a town package.`,
    resortsMore: "Compare every resort",
    from: "From",
    perPerson: "per person",

    pkgEyebrow: "Packages & prices",
    pkgTitle: "Compare every resort, side by side.",
    pkgLead:
      "Prices are per person, by length of stay. Every package includes accommodation, meals, airport transport and boat transport. Availability is on request.",

    diveEyebrow: "Diving & Sipadan",
    diveTitle: "Down to the wall.",
    diveLead:
      "Scuba diving, Sipadan packages, and PADI Open Water and Advanced Open Water certification. Sipadan is a protected site — permits are set by the park authority. Course length is a planning estimate, not a guarantee.",
    diveCta: "Ask about Sipadan",
    diveLink: "All diving packages",

    tripEyebrow: "Day trips",
    tripTitle: "Four routes, one day, out from the Semporna jetty.",
    tripLead:
      "Boat, lunch, guide, jetty fee and a snorkelling set are included on every route. The life jacket is rented separately.",
    tripLink: "All day trips",
    tripPhotoEyebrow: "Trip photos",
    tripPhotoTitle: "Real frames from our own trips",
    tripPhotoLead:
      "These were taken on our own Semporna trips and are shared with the permission of the guests in them.",

    galEyebrow: "Gallery",
    galTitle: "Footage from our own water.",
    galLead: "Short clips from our trips, no sound. Drag to explore.",

    teaserEyebrow: "Semporna",
    teaserTitle: "This sea is never the same on any two days.",
    teaserLead: "Tell us when you want to come, and we will shape the trip around it.",
    teaserMarquee: "Explore Semporna",
    teaserCta: "Plan your trip",

    planEyebrow: "Plan your trip",
    planTitle: "Pick a package in three questions.",
    planLead:
      "Answer three questions — we show a short list and prepare a WhatsApp message already filled in with your package codes.",
    planSteps: [
      "Who is travelling — a family, a group, or certified divers?",
      "How many nights — 2D1N, 3D2N, or 4D3N?",
      "Snorkelling only, or down to the Sipadan wall?",
    ],
    planLink: "Open the trip planner",

    navEyebrow: "Every page",
    navTitle: "Where to next",
  },
}[lang];
---

<Base
  route="home"
  lang={lang}
  title={c.title}
  description={c.desc}
  theme="2"
  heroVideo
>
  {/* ---- 01 · Hero ---------------------------------------------------- */}
  <HeroVideo
    lang={lang}
    eyebrow={c.heroEyebrow}
    heading={c.h1}
    lead={c.heroLead}
    scrollLabel={c.scroll}
    playLabel={c.playLabel}
    pauseLabel={c.pauseLabel}
  />

  {/* ---- 02 · Vision. Theme 1, light. -------------------------------- */}
  <section class="band" id="after-hero" data-theme-section="1">
    <div class="rail">
      <div class="split">
        <div>
          <p class="eyebrow-b">{c.visionEyebrow}</p>
          <Reveal as="h2" text={c.visionTitle} class="title-b title-b--lg" />
          <p class="lead-b">{c.visionLead}</p>
          <p class="vision__cta">
            <a class="link-b" href={href("about", lang)}>{c.visionCta}</a>
          </p>
        </div>
        <figure class="vision__fig">
          <Img
            slot="cm-stilt-lagoon"
            alt={creditAlt("cm-stilt-lagoon", lang)}
            sizes="(min-width: 900px) 46vw, 92vw"
            ratio="3 / 4"
          />
          <figcaption class="cap-b">{c.visionImgCap}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ---- 03 · Resorts, as a drag gallery. Theme 1, light. ------------ */}
  <section class="band band--tight" data-theme-section="1">
    <div class="rail">
      <p class="eyebrow-b">{c.resortsEyebrow}</p>
      <Reveal as="h2" text={c.resortsTitle} class="title-b title-b--lg" />
      <p class="sub-b resorts__sub">{c.resortsSub}</p>
    </div>

    <div class="resorts__strip">
      <DragGallery lang={lang} id="resort-strip" label={c.resortsTitle}>
        {resortCards.map(({ resort, tile, still, from }) => (
          <a class="rcard" href={resortDetailPath(resort.slug, lang)}>
            <div class="rcard__media">
              {tile
                ? <VideoTile tile={tile} lang={lang} showLabel={false} ratio="3 / 4" />
                : <Img slot={still} alt={creditAlt(still, lang)} sizes="(min-width: 900px) 26vw, 72vw" ratio="3 / 4" />}
            </div>
            <p class="rcard__name">{resort.name}</p>
            <p class="rcard__room">{resort.room}</p>
            <p class="rcard__price">
              <span class="rcard__from">{c.from}</span>
              <Gated value={from} kind="price" blocker={resort.blockers?.[0]} lang={lang} />
              <span class="rcard__per">{c.perPerson}</span>
            </p>
          </a>
        ))}
      </DragGallery>
    </div>

    <div class="rail resorts__more">
      <a class="link-b" href={href("resorts", lang)}>{c.resortsMore}</a>
    </div>
  </section>

  {/* ---- 04 · Packages, the comparison table. Theme 3, sand. ---------
      Logic untouched — this is a restyle. Every cell still renders through
      <Gated>, so a missing amount is the approved fallback, never a raw
      blocker token and never 0. */}
  <section class="band" id="pakej" data-theme-section="3">
    <div class="rail">
      <div class="pkg__head">
        <p class="eyebrow-b">{c.pkgEyebrow}</p>
        <Reveal as="h2" text={c.pkgTitle} class="title-b" />
        <p class="lead-b">{c.pkgLead}</p>
      </div>
    </div>
    <div class="rail pkg__table">
      <PriceComparison lang={lang} />
    </div>
  </section>

  {/* ---- 05 · Diving & Sipadan. Theme 2, dark. Asymmetric grid. ------ */}
  <section class="band" data-theme-section="2">
    <div class="rail">
      <div class="dive">
        <div class="dive__text">
          <p class="eyebrow-b">{c.diveEyebrow}</p>
          <Reveal as="h2" text={c.diveTitle} class="title-b title-b--lg" />
          <p class="lead-b">{c.diveLead}</p>
          <div class="dive__cta">
            <WhatsAppCTA lang={lang} code="SPTT-DV-SIPADAN" product="Sipadan" label={c.diveCta} />
            <a class="link-b" href={href("diving", lang)}>{c.diveLink}</a>
          </div>
        </div>

        <div class="dive__grid">
          <figure class="dive__wide">
            <Img
              slot="cm-sipadan-wall"
              alt={creditAlt("cm-sipadan-wall", lang)}
              sizes="(min-width: 900px) 52vw, 92vw"
              ratio="3 / 2"
            />
          </figure>
          {diveTiles.map((t) => (
            <VideoTile tile={t} lang={lang} showLabel={false} class="dive__tile" />
          ))}
          <figure class="dive__tall">
            <Img
              slot="cm-turtle"
              alt={creditAlt("cm-turtle", lang)}
              sizes="(min-width: 900px) 26vw, 46vw"
              ratio="3 / 4"
            />
          </figure>
          <figure class="dive__tall">
            <Img
              slot="cm-jackfish"
              alt={creditAlt("cm-jackfish", lang)}
              sizes="(min-width: 900px) 26vw, 46vw"
              ratio="3 / 4"
            />
          </figure>
        </div>
      </div>
    </div>
  </section>

  {/* ---- 06 · Day trips. Theme 1, light. ----------------------------- */}
  <section class="band" data-theme-section="1">
    <div class="rail">
      <div class="split">
        <div>
          <p class="eyebrow-b">{c.tripEyebrow}</p>
          <Reveal as="h2" text={c.tripTitle} class="title-b" />
          <p class="lead-b">{c.tripLead}</p>
          <ul class="trips">
            {DAY_TRIPS.map((tr) => (
              <li class="trip">
                <span class="trip__where">
                  <span class="trip__area">{tr.area[lang]}</span>
                  <span class="trip__dest">{tr.destinations.join(" · ")}</span>
                </span>
                <span class="trip__price">
                  <Gated value={tr.local} kind="price" blocker="B02" lang={lang} />
                  <span class="trip__per">{c.perPerson}</span>
                </span>
              </li>
            ))}
          </ul>
          <p class="vision__cta">
            <a class="link-b" href={href("dayTrips", lang)}>{c.tripLink}</a>
          </p>
        </div>
        <figure class="vision__fig">
          <Img
            slot="cm-white-beach"
            alt={creditAlt("cm-white-beach", lang)}
            sizes="(min-width: 900px) 46vw, 92vw"
            ratio="4 / 5"
          />
        </figure>
      </div>
    </div>
  </section>

  {/* ---- 06b · The seven cleared guest photographs, large. -----------
      CONTEXT.md §5: these frames render ONLY inside <GuestGallery>, which
      labels them in the page as real guest photos published with permission.
      The drag layout is a layout switch, not an exit from that component. */}
  <GuestGallery
    lang={lang}
    theme="1"
    surface="light"
    layout="drag"
    id="guest-strip"
    eyebrow={c.tripPhotoEyebrow}
    title={c.tripPhotoTitle}
    lead={c.tripPhotoLead}
    items={gallery(
      ["boatGroup", "boheyDulang", "sandbarSea", "boatSelfie", "heartSandbar", "groupSign", "boatThumbs"],
      lang,
    )}
  />

  {/* ---- 07 · Gallery of reels. Theme 3, sand. ----------------------- */}
  <section class="band" data-theme-section="3">
    <div class="rail">
      <p class="eyebrow-b">{c.galEyebrow}</p>
      <Reveal as="h2" text={c.galTitle} class="title-b" />
      <p class="lead-b">{c.galLead}</p>
    </div>
    <div class="gal__strip">
      <DragGallery lang={lang} id="reel-strip" label={c.galTitle}>
        {galleryTiles.map((t) => <VideoTile tile={t} lang={lang} />)}
      </DragGallery>
    </div>
  </section>

  {/* ---- 08 · Fullscreen teaser with the marquee. Theme 2, dark. ----- */}
  <FullscreenTeaser
    lang={lang}
    eyebrow={c.teaserEyebrow}
    title={c.teaserTitle}
    lead={c.teaserLead}
    marquee={c.teaserMarquee}
    href={href("planner", lang)}
    cta={c.teaserCta}
  />

  {/* ---- 09 · Trip shaper. Theme 1, light. --------------------------- */}
  <section class="band" data-theme-section="1">
    <div class="rail plan">
      <p class="eyebrow-b">{c.planEyebrow}</p>
      <Reveal as="h2" text={c.planTitle} class="title-b" />
      <p class="lead-b">{c.planLead}</p>
      <ol class="steps">
        {c.planSteps.map((s, i) => (
          <li class="steps__item">
            <span class="steps__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span class="steps__q">{s}</span>
          </li>
        ))}
      </ol>
      <p class="plan__cta">
        <a class="link-b" href={href("planner", lang)}>{c.planLink}</a>
      </p>
    </div>
  </section>

  {/* ---- 10 · Master nav strip. Theme 3, sand. ----------------------- */}
  <section class="band band--tight" data-theme-section="3">
    <div class="rail">
      <p class="eyebrow-b">{c.navEyebrow}</p>
      <Reveal as="h2" text={c.navTitle} class="title-b" />
      <ul class="master">
        {MASTER.map((id, i) => (
          <li class="master__item">
            <a class="master__link" href={ROUTES[id][lang]}>
              <span class="master__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="master__t">{ROUTES[id].title[lang]}</span>
              <span class="master__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---- Vision + day trips: the 50/50 with a bleeding figure ---------- */
  .vision__fig { margin: 0; }
  .vision__cta { margin-top: clamp(2rem, 4vw, 3rem); }

  .cap-b {
    margin-top: 0.875rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--s-rule, var(--t-rule));
    font-size: var(--text-caption);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--s-muted, var(--t-muted));
  }

  /* ---- Resorts strip ------------------------------------------------ */
  .resorts__sub { margin-top: 1.25rem; }
  .resorts__strip { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .resorts__more { margin-top: 2.5rem; }

  .rcard {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .rcard__media { border-radius: 0; overflow: hidden; }
  .rcard :global(.img img) { border-radius: 0; }

  .rcard__name {
    margin: 1.125rem 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-heading-sm);
    line-height: 1.2;
  }
  .rcard__room,
  .rcard__price {
    margin: 0.35rem 0 0;
    font-size: var(--text-caption);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--s-muted, var(--t-muted));
  }
  .rcard__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: 0.6rem;
    color: inherit;
  }
  .rcard__from,
  .rcard__per { color: var(--s-muted, var(--t-muted)); }
  .rcard:hover .rcard__name { color: var(--s-accent, var(--t-accent)); }

  /* ---- Packages ----------------------------------------------------- */
  .pkg__head { max-width: 46rem; }
  .pkg__table { margin-top: clamp(2.5rem, 5vw, 4rem); }

  /* ---- Diving: text left, an asymmetric grid right ------------------ */
  .dive { display: grid; gap: clamp(2.5rem, 6vw, 5rem); }
