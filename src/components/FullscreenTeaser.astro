---
/**
 * <FullscreenTeaser> — the dark Ocean Deep panel, motion #7.
 *
 * The reference's "Experience Arosa" band: a full-bleed dark section with one
 * serif line and a link beneath it.
 *
 * The sliding "Terokai Semporna" / "Explore Semporna" marquee that used to run
 * under the copy was removed on the owner's direction (2026-09-04). It carried
 * no information the CTA above it did not already carry, and it was the only
 * always-on animation left on the page.
 */
import type { Lang } from "../lib/gated";

interface Props {
  lang: Lang;
  eyebrow?: string;
  /** The serif line. Word-split at runtime by <Reveal>'s initialiser. */
  title: string;
  lead?: string;
  href: string;
  cta: string;
}

const { lang, eyebrow, title, lead, href, cta } = Astro.props;
---

<section class="ft" data-theme-section="2">
  <div class="ft__inner">
    {eyebrow && <p class="ft__eyebrow">{eyebrow}</p>}
    <h2 class="rv ft__title" data-reveal-words>{title}</h2>
    {lead && <p class="ft__lead">{lead}</p>}
    <a class="ft__cta" href={href}>{cta}</a>
  </div>
</section>

<style>
  .ft {
    position: relative;
    padding-block: var(--sec-pad);
    overflow: hidden;
  }

  .ft__inner {
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
    text-align: center;
  }

  .ft__eyebrow {
    margin: 0 0 1.75rem;
    font-size: var(--text-caption);
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--s-muted, #7E93A3);
  }

  .ft__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: var(--lh-h2);
    margin: 0 auto;
    max-width: 18ch;
  }

  .ft__lead {
    margin: 1.75rem auto 0;
    max-width: 52ch;
    font-size: var(--text-lead);
    line-height: var(--lh-lead);
    color: var(--s-muted, #7E93A3);
  }

  .ft__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    margin-top: 2.5rem;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid currentColor;
    border-radius: 0;
    color: inherit;
    text-decoration: none;
    font-size: var(--text-caption);
    letter-spacing: 2px;
    text-transform: uppercase;
  }
  .ft__cta:hover { color: #E0C08A; }

</style>
